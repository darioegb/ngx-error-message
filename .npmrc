engine-strict=true
# Puppeteer's postinstall downloads Chrome to ~/.cache/puppeteer, outside
# node_modules. pnpm's side-effects cache replays cached postinstall output
# once the store is warm instead of re-running the script, which silently
# skips that download and leaves Karma unable to find Chrome. Disable it so
# the script always runs.
side-effects-cache=false
