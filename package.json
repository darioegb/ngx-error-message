    "lint-staged": "^16.4.0",
    "ng-packagr": "^19.2.2",
    "ngx-translate-testing": "^6.0.1",
    "prettier": "^3.2.5",
    "puppeteer": "^22.9.0",
    "semantic-release": "^24.2.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.0.0"
