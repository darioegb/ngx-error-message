    "node": "^18.19.1 || ^20.11.1 || >=22.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng build ngx-error-message && ng serve ngx-error-message-showcase",
    "build": "ng build",
    "test": "ng test",
    "test:lib": "ng test ngx-error-message --code-coverage --watch=false --browsers=ChromeHeadlessNoSandbox",
    "lint": "ng lint",
    "lint:fix": "ng lint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "release": "semantic-release"
