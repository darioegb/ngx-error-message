{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../out-tsc/spec-ngx-translate",
    "types": ["vitest/globals"]
  },
  "include": [
    "**/*.spec.ts",
    "**/*.d.ts",
    "../../../testing/**/*.ts",
    "../src/**/*.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
