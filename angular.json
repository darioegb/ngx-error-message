{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "ngx-error-message": {
      "projectType": "library",
      "root": "projects/ngx-error-message",
      "sourceRoot": "projects/ngx-error-message/src",
      "prefix": "lib",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "tsConfig": "projects/ngx-error-message/tsconfig.lib.json",
            "project": "projects/ngx-error-message/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-error-message/tsconfig.lib.prod.json"
            },
            "development": {}
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-error-message/tsconfig.spec.json",
            "runnerConfig": true,
            "coverage": true,
            "coverageInclude": ["projects/ngx-error-message/src/**/*.ts"],
            "coverageExclude": ["projects/ngx-error-message/src/**/*.spec.ts"],
            "coverageReporters": [
              "lcovonly",
              "html",
              ["text-summary", { "file": "text-summary.txt" }]
            ],
            "coverageThresholds": {
              "statements": 80,
              "branches": 80,
              "functions": 80,
              "lines": 80
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-error-message/**/*.ts",
              "projects/ngx-error-message/**/*.html"
            ]
          }
        }
      }
    },
    "ngx-error-message-showcase": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "projects/ngx-error-message-showcase",
      "sourceRoot": "projects/ngx-error-message-showcase/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": {
              "base": "dist/ngx-error-message-showcase"
            },
            "index": "projects/ngx-error-message-showcase/src/index.html",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/ngx-error-message-showcase/tsconfig.app.json",
            "preserveSymlinks": true,
            "assets": [
              "projects/ngx-error-message-showcase/src/favicon.ico",
              "projects/ngx-error-message-showcase/src/assets"
            ],
            "styles": ["projects/ngx-error-message-showcase/src/styles.scss"],
            "scripts": [],
            "browser": "projects/ngx-error-message-showcase/src/main.ts"
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "projects/ngx-error-message-showcase/src/environments/environment.ts",
                  "with": "projects/ngx-error-message-showcase/src/environments/environment.prod.ts"
                }
              ],
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "namedChunks": false,
              "extractLicenses": true,
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2mb",
                  "maximumError": "5mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "10kb"
                }
              ]
            },
            "development": {
              "extractLicenses": false,
              "sourceMap": true,
              "optimization": false,
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "ngx-error-message-showcase:build:development"
          },
          "configurations": {
            "production": {
              "buildTarget": "ngx-error-message-showcase:build:production"
            }
          }
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "ngx-error-message-showcase:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-error-message-showcase/tsconfig.spec.json",
            "runnerConfig": true,
            "coverage": true,
            "coverageInclude": [
              "projects/ngx-error-message-showcase/src/**/*.ts"
            ],
            "coverageExclude": [
              "projects/ngx-error-message-showcase/src/**/*.spec.ts",
              "projects/ngx-error-message-showcase/src/main.ts",
              "projects/ngx-error-message-showcase/src/app/app.config.ts",
              "projects/ngx-error-message-showcase/src/app/app.routes.ts",
              "projects/ngx-error-message-showcase/src/app/**/*.routes.ts",
              "projects/ngx-error-message-showcase/src/app/**/index.ts",
              "projects/ngx-error-message-showcase/src/environments/**"
            ],
            "coverageReporters": [
              "lcovonly",
              "html",
              ["text-summary", { "file": "text-summary.txt" }]
            ],
            "coverageThresholds": {
              "statements": 80,
              "branches": 80,
              "functions": 80,
              "lines": 80
            }
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "projects/ngx-error-message-showcase/**/*.ts",
              "projects/ngx-error-message-showcase/**/*.html"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "schematicCollections": ["@angular-eslint/schematics"]
  },
  "schematics": {
    "@schematics/angular:component": {
      "type": "component"
    },
    "@schematics/angular:directive": {
      "type": "directive"
    },
    "@schematics/angular:service": {
      "type": "service"
    },
    "@schematics/angular:guard": {
      "typeSeparator": "."
    },
    "@schematics/angular:interceptor": {
      "typeSeparator": "."
    },
    "@schematics/angular:module": {
      "typeSeparator": "."
    },
    "@schematics/angular:pipe": {
      "typeSeparator": "."
    },
    "@schematics/angular:resolver": {
      "typeSeparator": "."
    }
  }
}
