{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    [
      "@semantic-release/release-notes-generator",
      { "preset": "conventionalcommits" }
    ],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "node scripts/set-lib-version.mjs ${nextRelease.version} && pnpm ng build ngx-error-message"
      }
    ],
    ["@semantic-release/npm", { "pkgRoot": "dist/ngx-error-message" }],
    [
      "@semantic-release/git",
      {
        "assets": ["CHANGELOG.md", "projects/ngx-error-message/package.json"],
        "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
      }
    ],
    "@semantic-release/github"
  ]
}
